# --- Server ---
PORT=3000
NODE_ENV=development
# browser origin allowed to send cookies (CORS); defaults to reflecting the request origin
FRONTEND_URL=http://localhost:3002

# --- Database (Postgres / Neon) — used via @repo/db ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Redis — used via @repo/redis (auth token cache, rate limits, email queue) ---
REDIS_URL=redis://default:password@host:6379

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# comma-separated emails allowed to use /admin routes
ADMIN_EMAILS=you@example.com
# bcrypt cost factor (default 10)
SALT_ROUNDS=10
# prefix for generated API keys (default sk_)
API_PREFIX=sk_

# --- Email (Resend) — needed by the email worker process ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
